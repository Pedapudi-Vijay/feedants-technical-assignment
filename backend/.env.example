# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/feedants
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/feedants
MONGO_URI=mongodb://127.0.0.1:27017/feedants

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - comma separated origins allowed to call the API (mobile apps usually don't need this,
# but it matters if you add a web/admin client)
CORS_ORIGIN=*
